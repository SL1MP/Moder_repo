# ============================================================================
# Сервис модерации внешних пакетов — обновление УЖЕ РАЗВЁРНУТОГО стенда
# с python-версии на go-версию.
#
# Отличается от .env.example тем, что перечисляет только то, что go-версия
# действительно читает, и называет переименованные настройки: стенд, поднятый
# на python-версии, после обновления тихо потеряет часть поведения, если .env
# оставить как есть.
#
# Репозиторий публичный: адреса и пароли сюда не коммитятся. Подставьте свои
# значения локально — файл .env в .gitignore.
#
# Строки, требующие вашего решения, помечены  # ❗ЗАПОЛНИТЬ  или  # ❗ПРОВЕРИТЬ.
# Порядок применения — в конце файла.
# ============================================================================

# --- общее ------------------------------------------------------------------
APP_ENV=prod                       # dev | prod
APP_NAME=Модерация пакетов
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
PUBLIC_BASE_URL=                    # ❗ЗАПОЛНИТЬ: https://ваш-хост
LISTEN_ADDR=:8000                  # порт наружу не публикуется, доступ через nginx

# --- база данных ------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=moderation
POSTGRES_USER=moderation
POSTGRES_PASSWORD=                  # ❗ЗАПОЛНИТЬ
# go-версии нужен готовый DSN (python собирал его из POSTGRES_* выше).
# В docker-compose он подставляется в environment у api-go/worker-go/migrate-go,
# поэтому пустое значение здесь работает. Заполните, если запускаете бинарник
# вне compose.
DATABASE_URL=

# --- надёжность обработки очереди -------------------------------------------
# Очередь живёт в Postgres (FOR UPDATE SKIP LOCKED + LISTEN/NOTIFY). Если
# worker-go молчит, конвейер подхватывает сторож внутри api-go.
PIPELINE_WATCHDOG_ENABLED=true
PIPELINE_WATCHDOG_INTERVAL_SECONDS=30   # как часто сторож смотрит очередь
PIPELINE_STUCK_AFTER_SECONDS=120        # после скольких секунд пакет считается зависшим

# --- политики модерации -----------------------------------------------------
QUARANTINE_DAYS=14                  # версия моложе N дней -> карантин (шаг 2)
VULN_MAX_SCORE=80                   # порог 0..100 (CVSS x 10); выше -> fail (шаг 5)
BLACKLIST_FILE=/config/blacklist.yml
ALLOWED_LICENSES_FILE=/config/licenses.yml

# --- песочница (шаг 6) ------------------------------------------------------
# Шаг включается САМ, как только задан SANDBOX_URL. Пока адреса нет, шаг
# отдаёт pass с пометкой «выключен настройкой» — то есть динамической проверки
# по факту не происходит.
#
# Вердикты: CLEAN -> pass; DANGEROUS -> fail (публикация заблокирована);
# UNWANTED -> pass с пометкой в отчёте; нет ответа -> warn и решение DevSecOps.
SANDBOX_URL=                        # ❗ЗАПОЛНИТЬ: адрес песочницы
SANDBOX_TOKEN=                      # ❗ЗАПОЛНИТЬ: значение X-API-Key (можно задать как SEC_TOKEN)
SANDBOX_PRIORITY=3
SANDBOX_SHORT_RESULT=true
SANDBOX_TIMEOUT_SECONDS=900         # проверка идёт минутами, отсюда запас
SANDBOX_INSECURE_TLS=false          # не включать: проверка сертификата отключается целиком

# --- реестры пакетных менеджеров -------------------------------------------
REGISTRY_PYPI_URL=https://pypi.org
REGISTRY_NPM_URL=https://registry.npmjs.org
REGISTRY_GO_PROXY=https://proxy.golang.org
REGISTRY_NUGET_URL=https://api.nuget.org
# Добавленные менеджеры.
REGISTRY_MAVEN_URL=https://repo1.maven.org/maven2
REGISTRY_MAVEN_SEARCH_URL=https://search.maven.org
REGISTRY_DOCKER_URL=https://registry-1.docker.io
REGISTRY_DOCKER_AUTH_URL=https://auth.docker.io/token
REGISTRY_DOCKER_SERVICE=registry.docker.io
REGISTRY_CONAN_URL=https://center.conan.io
REGISTRY_LUAROCKS_URL=https://luarocks.org
REGISTRY_TERRAFORM_URL=https://registry.terraform.io
REGISTRY_PACKAGIST_URL=https://repo.packagist.org
# Менеджер `git` клонирует срез репозитория этим бинарём.
GIT_BINARY=git
GIT_CLONE_TIMEOUT_SECONDS=600

# --- повторы и предохранитель на вызовах к реестрам -------------------------
# Пришли на смену HTTP_RETRIES и CIRCUIT_BREAKER_*: повторяется отдельный
# запрос, а не весь прогон пакета целиком.
REGISTRY_RETRY_ATTEMPTS=3               # было HTTP_RETRIES=3
REGISTRY_RETRY_BASE_DELAY_MS=200
REGISTRY_RETRY_MAX_DELAY_MS=5000
REGISTRY_BREAKER_THRESHOLD=5            # было CIRCUIT_BREAKER_FAIL_MAX=5
REGISTRY_BREAKER_OPEN_SECONDS=60        # было CIRCUIT_BREAKER_RESET_SECONDS=60

# --- сеть -------------------------------------------------------------------
# Пробрасывается в api-go и worker-go. Внутренние адреса обязательно в NO_PROXY.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,db,nexus,keycloak,api-go,web,nginx

# --- артефактори ------------------------------------------------------------
# ❗ПРОВЕРИТЬ: при ARTIFACT_STORE=nexus сервис умеет публиковать только
# pypi, npm, nuget и go. Для maven, docker, conan, luarocks, terraform, php,
# git и files публикация упадёт на ПОСЛЕДНЕМ шаге — после скачивания,
# проверок и, возможно, уже принятого решения DevSecOps.
# Либо generic (JFrog Artifactory и совместимые), либо эти менеджеры пока не
# заводить.
ARTIFACT_STORE=nexus                # nexus | generic
ARTIFACT_BASE_URL=http://nexus:8081
ARTIFACT_USER=admin
ARTIFACT_TOKEN=                     # ❗ЗАПОЛНИТЬ: пароль/токен ARTIFACT_USER
ARTIFACT_AUTH_TYPE=basic            # basic | token — только для generic
ARTIFACT_DRY_RUN=false              # true — проверить конвейер, ничего не публикуя

# Промежуточная зона и отчёты. Заводятся в артефактори как RAW HOSTED:
# сервис пишет туда обычным PUT по пути.
#
# Промежуточная зона — карантин, а не архив: пакет лежит в ней, пока идут
# проверки, и удаляется сразу после публикации или отклонения. Она ОБЯЗАНА
# отличаться от репозиториев менеджеров — иначе непроверенный пакет оказался
# бы там, откуда ставят разработчики. Сервис проверяет это на старте.
ARTIFACT_REPO_STAGING=moderation-staging
ARTIFACT_REPO_REPORTS=moderation-reports
ARTIFACT_REPO_OSV=osv-snapshots     # raw-репозиторий со снапшотами базы OSV

# Репозиторий на каждый менеджер. Умолчание — {менеджер}-internal.
ARTIFACT_REPO_PYPI=pypi-internal
ARTIFACT_REPO_NPM=npm-internal
ARTIFACT_REPO_GO=go-internal
ARTIFACT_REPO_NUGET=nuget-internal
ARTIFACT_REPO_MAVEN=maven-internal
ARTIFACT_REPO_DOCKER=docker-internal
ARTIFACT_REPO_CONAN=conan-internal
ARTIFACT_REPO_LUAROCKS=luarocks-internal
ARTIFACT_REPO_TERRAFORM=terraform-internal
ARTIFACT_REPO_PHP=php-internal
ARTIFACT_REPO_GIT=git-internal
ARTIFACT_REPO_FILES=files-internal

# --- база уязвимостей OSV ---------------------------------------------------
# Три источника на выбор, разбор компромиссов — docs/osv-snapshot.md.
#   artifactory — файл в ARTIFACT_REPO_OSV по пути OSV_SNAPSHOT_PATH
#   http        — любой адрес, нужны OSV_DB_URL (и при необходимости OSV_DB_TOKEN)
#   file        — файл на диске воркера, нужен OSV_DB_FILE
OSV_DB_SOURCE=artifactory
OSV_SNAPSHOT_PATH=osv/latest/osv-all.zip
OSV_LOCAL_DB_PATH=/var/lib/osv-db   # куда распаковывается снапшот
OSV_MAX_STALENESS_DAYS=3            # снапшот старше -> warn на шаге уязвимостей
OSV_DB_URL=                         # только при OSV_DB_SOURCE=http
OSV_DB_TOKEN=                       # только при OSV_DB_SOURCE=http, уходит в Authorization
OSV_DB_FILE=                        # только при OSV_DB_SOURCE=file

# --- регламентные задачи worker-go ------------------------------------------
# Работа тихая: если она не выполняется, ничего не падает — карантин просто
# перестаёт сниматься сам, а промежуточная зона растёт.
MAINTENANCE_ENABLED=true
QUARANTINE_SWEEP_INTERVAL_SECONDS=900   # снятие истёкшего карантина, раз в 15 минут
STAGING_CLEANUP_INTERVAL_SECONDS=7200   # уборка промежуточной зоны, раз в 2 часа
STAGING_ORPHAN_TTL_HOURS=24             # через сколько часов файл считается брошенным
# Пришло на смену OSV_SYNC_CRON: расписание задаётся интервалом.
# 86400 = раз в сутки, 21600 = раз в 6 часов.
# 0 — выключить (снапшот кладут снаружи).
OSV_SYNC_INTERVAL_SECONDS=86400

# --- наблюдатель сканирования -----------------------------------------------
SCAN_WATCHER_ENABLED=true
SCAN_WATCHER_INTERVAL_SECONDS=60
SCAN_WATCHER_BATCH=10
SCAN_WATCHER_ITEM_TIMEOUT_SECONDS=1200
SCAN_MAX_UNPACKED_BYTES=2147483648      # защита от архивных бомб при распаковке
SCAN_MAX_FILES=20000

# --- раскрытие транзитивных зависимостей ------------------------------------
RESOLVE_MAX_DEPTH=3
RESOLVE_MAX_PACKAGES=200
RESOLVE_INCLUDE_OPTIONAL=false
RESOLVE_CONCURRENCY=8

# --- доступ (OIDC / Keycloak) ----------------------------------------------
OIDC_ISSUER=http://keycloak:8080/realms/moderation
OIDC_PUBLIC_ISSUER=https://ВАШ-ХОСТ/realms/moderation
OIDC_CLIENT_ID=moderation-web
ROLE_MAPPING_ADMIN=moderation-admin
ROLE_MAPPING_DEVSECOPS=moderation-devsecops
ROLE_MAPPING_LEGAL=moderation-legal
ROLE_MAPPING_DEVELOPER=moderation-developer
LOCAL_AUTH_ENABLED=false            # вход логин/пароль (только сервисные учётки)
LOCAL_AUTH_SECRET=                  # ❗ЗАПОЛНИТЬ: ключ подписи локальных JWT
LOCAL_AUTH_TOKEN_TTL_MINUTES=480

# --- GitLab (только чтение) -------------------------------------------------
# Пусто — интеграция выключена, маршруты /api/v1/gitlab/* отвечают, что она
# не настроена. Формат шифрования токенов совпадает с python-версией:
# уже сохранённые подключения продолжают работать.
GITLAB_URL=
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_REDIRECT_URI=https://ВАШ-ХОСТ/api/v1/gitlab/callback
# Ключ Fernet для шифрования refresh-токенов GitLab (44 симв. base64).
# Сгенерировать: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- лимиты -----------------------------------------------------------------
MAX_UPLOAD_SIZE_BYTES=5242880       # размер файла зависимостей
MAX_PACKAGES_PER_REQUEST=200        # число пакетов в одной заявке
MAX_ARTIFACT_SIZE_BYTES=524288000   # лимит размера скачиваемого артефакта (500 МБ)
COMMENT_EDIT_WINDOW_MINUTES=15      # N минут на правку комментария без пометки «изменено»
# ❗ПРОВЕРИТЬ: python-версия это соблюдала, go-версия РАНЬШЕ игнорировала, а
# теперь соблюдает — то есть на обновлённом стенде лимит заработает впервые. Интерфейс при загрузке дёргает несколько маршрутов сразу,
# поэтому 30 запросов в минуту на пользователя может оказаться тесно.
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# --- снятые с конвейера шаги ------------------------------------------------
# banner_scan (YARA) и sast_scan (semgrep) сняты. Настройки оставлены: код
# сканеров цел, и возврат шага в строй — это миграция плюс строка в StepCodes,
# а не восстановление удалённого. Пока шагов нет, значения ни на что не влияют.
BANNER_SCAN_ENABLED=false
SAST_ENABLED=false
SAST_MIN_SEVERITY=medium            # info|low|medium|high|critical, проверяется на старте

# --- внешние контейнеры (compose profiles) ---------------------------------
NGINX_PORT=80
NGINX_TLS_PORT=443
NGINX_FORCE_HTTPS=true
TLS_COMMON_NAME=                    # ❗ЗАПОЛНИТЬ: имя хоста в сертификате
KEYCLOAK_PORT=8081
KEYCLOAK_TLS_PORT=8443
NEXUS_PORT=8082
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=            # ❗ЗАПОЛНИТЬ

# Пароль администратора Nexus переменной окружения не задаётся: образ
# sonatype/nexus3 такой возможности не даёт. Менять его нужно в самом Nexus —
# через UI или REST API. После смены обновите ARTIFACT_TOKEN выше: именно по
# паре ARTIFACT_USER / ARTIFACT_TOKEN сервис публикует пакеты.

# --- что убрано из файла ----------------------------------------------------
# Эти переменные go-версия не читает. Оставлять их — значит однажды править
# настройку, которая ни на что не влияет, и искать, почему ничего не меняется.
#
#   S3_ENDPOINT, S3_BUCKET, S3_ACCESS_KEY, S3_SECRET_KEY, S3_REGION, S3_SECURE
#       S3 из сервиса убран: промежуточная зона и отчёты живут в артефактори.
#   S3_ORPHAN_TTL_HOURS, S3_CLEANUP_INTERVAL_SECONDS
#       переименованы в STAGING_*; ПРЕЖНИЕ ИМЕНА ПРОДОЛЖАЮТ ПРИНИМАТЬСЯ, так
#       что спешить с правкой на работающем стенде не обязательно.
#   REDIS_URL, CELERY_BROKER_URL, CELERY_RESULT_BACKEND
#       очередь в Postgres, брокер не нужен. Redis остаётся только погашенной
#       python-версии (профиль `python` в docker-compose).
#   WORKER_HEARTBEAT_INTERVAL_SECONDS, WORKER_HEARTBEAT_TTL_SECONDS
#       отметка воркера жила в Redis; живость определяется по очереди в базе.
#   OSV_SOURCE, OSV_API_URL, OSV_SCANNER_BIN
#       заменены на OSV_DB_SOURCE; прямого запроса к osv.dev и внешнего
#       бинаря osv-scanner больше нет — проверка идёт по локальному снапшоту.
#   OSV_SYNC_CRON      -> OSV_SYNC_INTERVAL_SECONDS
#   HTTP_RETRIES       -> REGISTRY_RETRY_ATTEMPTS
#   HTTP_TIMEOUT_SECONDS
#       таймаут клиента общий и задан в коде (60 с).
#   CIRCUIT_BREAKER_FAIL_MAX      -> REGISTRY_BREAKER_THRESHOLD
#   CIRCUIT_BREAKER_RESET_SECONDS -> REGISTRY_BREAKER_OPEN_SECONDS
#   API_PORT, MINIO_PORT, MINIO_CONSOLE_PORT
#       python-api погашен, MinIO удалён.
#   OIDC_CLIENT_SECRET, OIDC_AUDIENCE
#       клиент публичный (Authorization Code + PKCE), секрет не используется.

# ============================================================================
# Порядок применения
#
# 1. Завести в Nexus три RAW HOSTED репозитория:
#       moderation-staging   moderation-reports   osv-snapshots
#    (osv-snapshots у вас уже есть). Плюс по репозиторию на каждый менеджер,
#    который собираетесь включать.
#
# 2. Положить этот файл как .env, накатить миграции и проверить репозитории:
#       docker compose run --rm migrate-go
#       docker compose run --rm api-go bootstrap --demo=false
#    Вторая команда перечислит все репозитории со статусом «есть» /
#    «НЕ НАЙДЕН» — до перезапуска сервиса, а не после.
#
# 3. Поднять стек:
#       docker compose up -d --build
#    python-контейнеры (api, worker, beat, redis) больше не поднимаются.
#    Откат, если что-то пойдёт не так:
#       docker compose --profile python up -d api worker beat
#
# 4. Проверить, что схема сошлась с кодом:
#       docker compose run --rm api-go schema
# ============================================================================
