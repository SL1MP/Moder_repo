# ============================================================================
# Сервис модерации внешних пакетов — пример конфигурации.
# Скопируйте в .env и заполните. Все политики применяются при старте сервиса;
# редактирование настроек через UI не предусмотрено (экран «Настройка» —
# только чтение с указанием имени переменной).
# ============================================================================

# --- общее ------------------------------------------------------------------
APP_ENV=dev                        # dev | prod — влияет на строгость проверок при старте
APP_NAME=Модерация пакетов         # заголовок в UI
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
# Внешний адрес сервиса: ссылки в уведомлениях и, что важнее, redirectUris
# клиента Keycloak — они подставляются в realm при сборке образа. После правки
# пересоберите Keycloak, иначе он отклонит редирект после логина:
#   docker compose --profile sso up -d --build keycloak
PUBLIC_BASE_URL=http://localhost:8080

# Редирект с HTTP на HTTPS. Локально не нужен (порт 80 отдаёт приложение);
# на хосте, доступном по имени, ставьте true.
NGINX_FORCE_HTTPS=false

# Образы с явными тегами: без тега тянется latest, а он на разных зеркалах
# разъезжается. Ловили сборку MinIO трёхлетней давности, где нет клиента `mc`.
MINIO_IMAGE=minio/minio:latest
NEXUS_IMAGE=sonatype/nexus3:latest

# --- база данных ------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=moderation
POSTGRES_USER=moderation
POSTGRES_PASSWORD=moderation        # СМЕНИТЬ в prod
# Полный DSN. Если пусто — собирается из POSTGRES_* выше.
DATABASE_URL=

# --- Celery / Redis ---------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- надёжность обработки очереди -------------------------------------------
# Пакет не должен ждать ручного запуска `moderctl run-pending`: если worker
# молчит или сообщение потерялось, конвейер подхватывает сторож внутри api.
PIPELINE_WATCHDOG_ENABLED=true
PIPELINE_WATCHDOG_INTERVAL_SECONDS=30   # как часто сторож смотрит очередь
PIPELINE_STUCK_AFTER_SECONDS=120        # после скольких секунд пакет считается зависшим
WORKER_HEARTBEAT_INTERVAL_SECONDS=15    # как часто worker отмечается в Redis
WORKER_HEARTBEAT_TTL_SECONDS=60         # без отметки дольше — worker считается мёртвым

# --- политики модерации -----------------------------------------------------
QUARANTINE_DAYS=14                  # версия моложе N дней -> карантин (шаг 2)
VULN_MAX_SCORE=80                   # порог 0..100 (CVSS x 10); выше -> fail (шаг 5)
BLACKLIST_FILE=/config/blacklist.yml
ALLOWED_LICENSES_FILE=/config/licenses.yml

# --- реестры пакетных менеджеров и сеть ------------------------------------
REGISTRY_PYPI_URL=https://pypi.org
REGISTRY_NPM_URL=https://registry.npmjs.org
REGISTRY_GO_PROXY=https://proxy.golang.org
REGISTRY_NUGET_URL=https://api.nuget.org

# Корпоративный прокси. Пробрасывается в api/worker/beat; клиенты реестров
# используют эти значения явно. Внутренние адреса обязательно в NO_PROXY.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,db,redis,minio,nexus,keycloak,api,web,nginx

# --- временное хранилище артефактов (MinIO / S3) ---------------------------
S3_ENDPOINT=http://minio:9000
S3_BUCKET=packages
S3_ACCESS_KEY=minioadmin            # СМЕНИТЬ в prod
S3_SECRET_KEY=minioadmin            # СМЕНИТЬ в prod
S3_REGION=us-east-1
S3_SECURE=false
S3_ORPHAN_TTL_HOURS=24              # через сколько часов фоновая задача удаляет зависшие объекты
#
# Отчёты о сканировании (Go-версия, backend-go) складываются в тот же бакет под
# префиксом reports/ — он переживает вычистку артефактов при отклонении пакета.
# Отдаются через API:
#   GET /api/v1/request-items/{id}/reports              — список отчётов пакета
#   GET /api/v1/request-items/{id}/reports/{step}.json  — машиночитаемый отчёт
#   GET /api/v1/request-items/{id}/reports/{step}.html  — отчёт для человека
# где {step} — banner_scan либо sast_scan.
# Без S3_ENDPOINT Go-сервис поднимается, но выдача отчётов отключена: падать на
# старте из-за недоступного хранилища нельзя, health должен отвечать.

# --- артефактори (один инстанс на все менеджеры) ---------------------------
ARTIFACT_STORE=nexus                # nexus | generic
ARTIFACT_BASE_URL=http://nexus:8081
ARTIFACT_USER=admin
ARTIFACT_TOKEN=admin123             # СМЕНИТЬ в prod
ARTIFACT_REPO_PYPI=pypi-internal
ARTIFACT_REPO_NPM=npm-internal
ARTIFACT_REPO_GO=go-internal
ARTIFACT_REPO_NUGET=nuget-internal
ARTIFACT_REPO_OSV=osv-snapshots     # raw-репозиторий со снапшотами базы OSV
# Только для ARTIFACT_STORE=generic (JFrog Artifactory и совместимые):
ARTIFACT_AUTH_TYPE=basic            # basic | token
ARTIFACT_PATH_TEMPLATE_PYPI={repo}/{name}/{filename}
ARTIFACT_PATH_TEMPLATE_NPM={repo}/{name}/-/{filename}
ARTIFACT_PATH_TEMPLATE_GO={repo}/{name}/@v/{filename}
ARTIFACT_PATH_TEMPLATE_NUGET={repo}/{name}/{version}/{filename}
# Весь конвейер выполняется по-настоящему (реальное скачивание, реальные сканеры),
# но шаг publish не пишет байты в целевой артефактори — только проверяет
# достижимость/авторизацию. Включать при тестировании реальными кредами от
# продового Artifactory, см. docs/testing.md.
ARTIFACT_DRY_RUN=false

# --- сканирование содержимого пакета ---------------------------------------
# Шаг 6: политические баннеры (протестварь) по правилам YARA. Файл правил тот
# же, что в CI-конвейерах модерации, — вердикт сервиса и CI не расходится.
BANNER_SCAN_ENABLED=true
BANNER_RULES_FILE=/config/rules.yar
BANNER_SCAN_TIMEOUT_SECONDS=10  # python-версия: таймаут на ОДИН файл
# Go-версия запускает yara на всё дерево распаковки сразу, поэтому у неё
# отдельная переменная: значение выше (10 с) на всё дерево означало бы, что
# проверка почти всегда обрывается и молча зовёт DevSecOps на каждом пакете.
BANNER_SCAN_TOTAL_TIMEOUT_SECONDS=300

# --- наблюдатель сканирования (Go-версия) -----------------------------------
# Сам находит пакеты заявок, по которым отчётов ещё нет, и прогоняет по ним
# сканеры. Нужен, пока заявки ведёт python-конвейер, а отчёты умеет делать
# только Go: без него отчёты появлялись бы только там, где не забыли запустить
# `moderation scan` вручную.
SCAN_WATCHER_ENABLED=true
SCAN_WATCHER_INTERVAL_SECONDS=60    # как часто смотреть, нет ли новых пакетов
SCAN_WATCHER_BATCH=10               # сколько пакетов разбирать за один проход

# Шаг 7: SAST по исходникам пакета. Бинарь внешний (как osv-scanner): если его
# нет в образе, шаг не пропускает пакет молча, а отдаёт решение DevSecOps.
SAST_ENABLED=true
SAST_SCANNER_BIN=semgrep
SAST_RULES=p/default            # набор правил semgrep либо путь к своему файлу
SAST_TIMEOUT_SECONDS=300
SAST_MIN_SEVERITY=high          # info|low|medium|high|critical — ниже порога не блокирует

# Границы распаковки артефакта перед сканированием (защита от архивной бомбы).
SCAN_MAX_UNPACKED_BYTES=536870912   # 512 МБ
SCAN_MAX_FILES=20000

# --- база уязвимостей OSV ---------------------------------------------------
OSV_SOURCE=snapshot                 # snapshot (боевой режим) | api (только локальная разработка)
OSV_SNAPSHOT_PATH=osv/latest/osv-all.zip   # путь к снапшоту внутри ARTIFACT_REPO_OSV
OSV_LOCAL_DB_PATH=/var/lib/osv-db   # куда распаковывается снапшот для offline-режима osv-scanner
OSV_SYNC_CRON=0 4 * * *
OSV_MAX_STALENESS_DAYS=3            # снапшот старше -> автоодобрение выключено, warn на шаге 5
OSV_API_URL=https://api.osv.dev
OSV_SCANNER_BIN=osv-scanner         # путь к бинарю; если недоступен — используется прямой запрос к индексу

# --- доступ (OIDC / Keycloak) ----------------------------------------------
OIDC_ISSUER=http://keycloak:8080/realms/moderation
# Issuer, видимый из БРАУЗЕРА. Keycloak проксируется nginx'ом на том же origin
# (см. nginx/snippets/app.conf), поэтому здесь адрес самого сервиса без
# отдельного порта — не localhost:8081 и не :8443. Отдельный порт для Keycloak
# наружу больше не нужен.
OIDC_PUBLIC_ISSUER=http://localhost:8080/realms/moderation
OIDC_CLIENT_ID=moderation-web
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=account
ROLE_MAPPING_ADMIN=moderation-admin
ROLE_MAPPING_DEVSECOPS=moderation-devsecops
ROLE_MAPPING_LEGAL=moderation-legal
ROLE_MAPPING_DEVELOPER=moderation-developer
LOCAL_AUTH_ENABLED=false            # fallback-вход логин/пароль (только сервисные учётки); в prod false
LOCAL_AUTH_SECRET=change-me-in-prod # ключ подписи локальных JWT
LOCAL_AUTH_TOKEN_TTL_MINUTES=480

# --- GitLab (только чтение) -------------------------------------------------
GITLAB_URL=
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/gitlab/callback
# Ключ Fernet для шифрования refresh-токенов GitLab (44 симв. base64).
# Сгенерировать: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- лимиты -----------------------------------------------------------------
MAX_UPLOAD_SIZE_BYTES=5242880       # размер файла зависимостей
MAX_PACKAGES_PER_REQUEST=200        # число пакетов в одной заявке
RATE_LIMIT_REQUESTS_PER_MINUTE=30   # частота запросов на пользователя
MAX_ARTIFACT_SIZE_BYTES=524288000   # лимит размера скачиваемого артефакта (500 МБ)
HTTP_TIMEOUT_SECONDS=30
HTTP_RETRIES=3
CIRCUIT_BREAKER_FAIL_MAX=5
CIRCUIT_BREAKER_RESET_SECONDS=60
COMMENT_EDIT_WINDOW_MINUTES=15      # N минут на правку комментария без пометки «изменено»

# --- внешние контейнеры (compose profiles) ---------------------------------
# Порты, публикуемые наружу в dev/override
NGINX_PORT=8080                     # HTTP; для боевого хоста 80
NGINX_TLS_PORT=8443                 # HTTPS; для боевого хоста 443
API_PORT=8000
KEYCLOAK_PORT=8081
KEYCLOAK_TLS_PORT=9443              # HTTPS Keycloak
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
NEXUS_PORT=8082
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin       # СМЕНИТЬ в prod

# Пароль администратора Nexus переменной окружения не задаётся: образ
# sonatype/nexus3 такой возможности не даёт. При первом старте с
# NEXUS_SECURITY_RANDOMPASSWORD=false (см. docker-compose.yml) действует
# встроенный пароль `admin123`, и менять его нужно в самом Nexus — через UI
# или REST API. После смены пароля обновите ARTIFACT_TOKEN выше: именно по
# паре ARTIFACT_USER / ARTIFACT_TOKEN сервис публикует пакеты.

# ============================================================================
# Развёртывание на хосте, доступном по имени (не localhost)
# ============================================================================
# SPA использует window.crypto.subtle для PKCE, а он доступен только в secure
# context — то есть по HTTPS либо на localhost. По HTTP на внешнем имени вход
# через SSO падает с "Cannot read properties of undefined (reading 'digest')".
# Поэтому для внешнего хоста HTTPS обязателен, а не желателен.
#
# 1. Сертификат (самоподписанный; в бою — от внутреннего CA):
#      make certs DOMAIN=service.example.com
#    Если этого не сделать, nginx сгенерирует самоподписанный сам при старте.
#
# 2. Значения в .env:
#      PUBLIC_BASE_URL=https://service.example.com
#      NGINX_PORT=80
#      NGINX_TLS_PORT=443
#      NGINX_FORCE_HTTPS=true
#      OIDC_PUBLIC_ISSUER=https://service.example.com/realms/moderation
#      GITLAB_OAUTH_REDIRECT_URI=https://service.example.com/api/v1/gitlab/callback
#
#    БЕЗ порта у OIDC_PUBLIC_ISSUER: Keycloak проксируется nginx'ом на 443
#    вместе с приложением. Раньше здесь стоял :8443, и это не работало —
#    Keycloak без сертификата HTTPS не поднимает (порт опубликован, а внутри
#    контейнера на нём никто не слушает: ERR_CONNECTION_REFUSED), плюс 8443
#    обычно закрыт фаерволом, плюс самоподписанный сертификат ронял бы fetch
#    к .well-known молча. KEYCLOAK_TLS_PORT наружу больше не нужен.
#
#    OIDC_ISSUER не трогать: он внутренний (http://keycloak:8080/realms/moderation),
#    api ходит по нему внутри сети compose. Сервис принимает оба issuer'а —
#    браузерный и внутренний.
#
# 3. Поднять:
#      docker compose --profile sso --profile nexus up -d --build
#
#    Оверлей docker-compose.tls.yml (общий сертификат для nginx и Keycloak)
#    теперь нужен ТОЛЬКО если вы сознательно выставляете Keycloak наружу
#    отдельным портом в обход nginx. Для обычного развёртывания он не нужен:
#    браузер ходит к Keycloak через nginx, сертификат один.
