# ============================================================================
# Сервис модерации внешних пакетов — пример конфигурации.
# Скопируйте в .env и заполните. Все политики применяются при старте сервиса;
# редактирование настроек через UI не предусмотрено (экран «Настройка» —
# только чтение с указанием имени переменной).
# ============================================================================

# --- общее ------------------------------------------------------------------
APP_ENV=dev                        # dev | prod — влияет на строгость проверок при старте
APP_NAME=Модерация пакетов         # заголовок в UI
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR (принимается и WARN)
# Внешний адрес сервиса: ссылки в уведомлениях и, что важнее, redirectUris
# клиента Keycloak — они подставляются в realm при сборке образа. После правки
# пересоберите Keycloak, иначе он отклонит редирект после логина:
#   docker compose --profile sso up -d --build keycloak
PUBLIC_BASE_URL=http://localhost:8080

# Редирект с HTTP на HTTPS. Локально не нужен (порт 80 отдаёт приложение);
# на хосте, доступном по имени, ставьте true.
NGINX_FORCE_HTTPS=false

# Образы с явными тегами: без тега тянется latest, а он на разных зеркалах
# разъезжается. Ловили сборку MinIO трёхлетней давности, где нет клиента `mc`.
#
# Отдельного объектного хранилища у сервиса больше нет: и промежуточная зона
# для скачанных пакетов, и отчёты живут в артефактори (см. раздел ниже). MinIO
# и переменные S3_* удалены вместе с ним.
NEXUS_IMAGE=sonatype/nexus3:latest

# --- база данных ------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=moderation
POSTGRES_USER=moderation
POSTGRES_PASSWORD=moderation        # СМЕНИТЬ в prod
# Полный DSN. Если пусто — собирается из POSTGRES_* выше.
DATABASE_URL=

# --- Celery / Redis ---------------------------------------------------------
# Нужны только погашенной python-версии (профиль `python` в docker-compose).
# Очередь go-версии живёт в Postgres, Redis ей не нужен вовсе.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- надёжность обработки очереди -------------------------------------------
# Пакет не должен ждать ручного запуска `moderctl run-pending`: если worker
# молчит или сообщение потерялось, конвейер подхватывает сторож внутри api.
PIPELINE_WATCHDOG_ENABLED=true
PIPELINE_WATCHDOG_INTERVAL_SECONDS=30   # как часто сторож смотрит очередь
PIPELINE_STUCK_AFTER_SECONDS=120        # после скольких секунд пакет считается зависшим
# WORKER_HEARTBEAT_* больше нет: отметка воркера жила в Redis, а go-очередь
# живёт в Postgres — живость видна по самой очереди.

# --- политики модерации -----------------------------------------------------
QUARANTINE_DAYS=14                  # версия моложе N дней -> карантин (шаг 2)
VULN_MAX_SCORE=80                   # порог 0..100 (CVSS x 10); выше -> fail (шаг 5)
BLACKLIST_FILE=/config/blacklist.yml
ALLOWED_LICENSES_FILE=/config/licenses.yml

# --- реестры пакетных менеджеров и сеть ------------------------------------
REGISTRY_PYPI_URL=https://pypi.org
REGISTRY_NPM_URL=https://registry.npmjs.org
REGISTRY_GO_PROXY=https://proxy.golang.org
REGISTRY_GO_LICENSE_URL=https://pkg.go.dev
REGISTRY_NUGET_URL=https://api.nuget.org

# Корпоративный прокси. Пробрасывается в api/worker/beat; клиенты реестров
# используют эти значения явно. Внутренние адреса обязательно в NO_PROXY.
#
# Пустые значения безопасны: во внешние сканеры пустые переменные прокси не
# передаются вовсе. Это не косметика — semgrep-core на пустом HTTP_PROXY
# падает («No host was provided in URI»), и SAST молча не работал.
# Если прокси есть, указывайте СО СХЕМОЙ: http://proxy.corp:3128, а не
# proxy.corp:3128 — semgrep на значении без схемы падает так же.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,db,redis,nexus,keycloak,api,web,nginx

# --- промежуточная зона и отчёты (оба — в артефактори) ---------------------
# Скачанный пакет лежит в ARTIFACT_REPO_STAGING, пока идут проверки, и после
# них переезжает в репозиторий своего менеджера — переносом внутри артефактори,
# без прогона байтов через сервис. Отчёты живут отдельно: артефакты
# вычищаются, отчёты обязаны это пережить.
#
# Оба репозитория обязаны быть типа raw (generic у Artifactory): в них
# кладутся файлы по произвольным путям, а не пакеты.
#
# ВАЖНО: промежуточная зона не должна совпадать ни с одним ARTIFACT_REPO_*
# менеджера — иначе непроверенный пакет оказался бы в репозитории, из которого
# ставят разработчики. Сервис проверяет это на старте и не поднимается.
ARTIFACT_REPO_STAGING=moderation-staging
ARTIFACT_REPO_REPORTS=moderation-reports
STAGING_ORPHAN_TTL_HOURS=24         # через сколько часов уборка удаляет зависшие файлы

# --- регламентные задачи go-воркера ------------------------------------------
# Читает go-воркер (в python-версии то же расписание ведёт celery beat).
# Работа тихая: если она не выполняется, ничего не падает — карантин просто
# перестаёт сниматься сам, а временное хранилище растёт. Поэтому выключать
# стоит только осознанно.
MAINTENANCE_ENABLED=true
QUARANTINE_SWEEP_INTERVAL_SECONDS=900   # снятие истёкшего карантина, раз в 15 минут
STAGING_CLEANUP_INTERVAL_SECONDS=7200   # уборка промежуточной зоны, раз в 2 часа
OSV_SYNC_INTERVAL_SECONDS=21600         # загрузка снапшота OSV, раз в 6 часов (0 — выключить)
#
# Отчёты о сканировании складываются в ARTIFACT_REPO_REPORTS и отдаются через API:
#   GET /api/v1/request-items/{id}/reports              — список отчётов пакета
#   GET /api/v1/request-items/{id}/reports/{step}.json  — машиночитаемый отчёт
#   GET /api/v1/request-items/{id}/reports/{step}.html  — отчёт для человека
# где {step} — sandbox_scan (а для старых заявок ещё banner_scan и sast_scan:
# шаги сняты, но отчёты, сделанные до снятия, обязаны открываться).
# Если репозиторий отчётов недоступен, сервис поднимается, но выдача отчётов
# отключается: падать на старте из-за артефактори нельзя, health должен отвечать.

# --- артефактори (один инстанс на все менеджеры) ---------------------------
# nexus | generic — и это не косметика: у них разные протоколы выгрузки.
# Nexus принимает пакет только компонентным API (POST /service/rest/v1/components,
# multipart), Artifactory — PUT'ом по адресу файла. Перепутали — каждая публикация
# падает с «артефактори отклонил публикацию … (405)».
ARTIFACT_STORE=nexus
ARTIFACT_BASE_URL=http://nexus:8081
ARTIFACT_USER=admin
ARTIFACT_TOKEN=admin123             # СМЕНИТЬ в prod
# Docker публикуется не компонентным API, а как настоящий multi-platform
# image. В Nexus >= 3.83 включите Docker path-based routing. Первый URL видит
# worker, второй попадёт в команду docker pull для разработчика:
ARTIFACT_DOCKER_REGISTRY_URL=http://nexus:8081/docker-internal
ARTIFACT_DOCKER_PUBLIC_URL=http://localhost:8082/docker-internal
# Для старого connector-port вместо path routing укажите, например:
# ARTIFACT_DOCKER_REGISTRY_URL=http://nexus:5000
# ARTIFACT_DOCKER_PUBLIC_URL=https://nexus.example.ru:5000
# Репозиторий на каждый менеджер: ARTIFACT_REPO_{МЕНЕДЖЕР}. Не заданный —
# «{менеджер}-internal», поэтому перечислять все двенадцать здесь не нужно,
# только те, что названы иначе.
ARTIFACT_REPO_PYPI=pypi-internal
ARTIFACT_REPO_NPM=npm-internal
ARTIFACT_REPO_GO=go-internal
ARTIFACT_REPO_NUGET=nuget-internal
ARTIFACT_REPO_MAVEN=maven-internal
ARTIFACT_REPO_DOCKER=docker-internal
ARTIFACT_REPO_CONAN=conan-internal
ARTIFACT_REPO_LUAROCKS=luarocks-internal
ARTIFACT_REPO_TERRAFORM=terraform-internal
ARTIFACT_REPO_PHP=php-internal
ARTIFACT_REPO_GIT=git-internal
ARTIFACT_REPO_FILES=files-internal
ARTIFACT_REPO_OSV=osv-snapshots     # raw-репозиторий со снапшотами базы OSV
# Только для ARTIFACT_STORE=generic (JFrog Artifactory и совместимые):
ARTIFACT_AUTH_TYPE=basic            # basic | token
# ARTIFACT_PATH_TEMPLATE_* больше нет: раскладку внутри репозитория задаёт
# плагин менеджера (ArtifactPath), а не настройка. Шаблон в .env расходился
# бы с тем, по какому адресу пакет потом ищет pip или npm.
# Весь конвейер выполняется по-настоящему (реальное скачивание, реальные сканеры),
# но шаг publish не пишет байты в целевой артефактори — только проверяет
# достижимость/авторизацию. Включать при тестировании реальными кредами от
# продового Artifactory, см. docs/testing.md.
ARTIFACT_DRY_RUN=false

# --- шаг 6: песочница -------------------------------------------------------
# Артефакт целиком уходит во внешнюю песочницу, та запускает его и возвращает
# вердикт. Соответствие вердикта и исхода:
#
#   CLEAN      публикация продолжается
#   UNWANTED   пометка в карточке и отчёте, публикацию НЕ держит
#   DANGEROUS  публикация заблокирована, решение принимает DevSecOps
#   иное/нет   вердикт неизвестен или песочница не ответила — тоже DevSecOps
#
# Имена переменных — те же, что в CI-шаблоне `.send_to_sandbox`, чтобы один и
# тот же секрет не приходилось заводить дважды под разными именами:
# SANDBOX_TOKEN можно не задавать, если уже есть SEC_TOKEN.
#
# Шаг включается сам, как только задан адрес, поэтому SANDBOX_ENABLED ниже
# закомментирован: явное true с пустым SANDBOX_URL — ошибка конфигурации
# (такой шаг отдавал бы на ручное решение каждый пакет), и сервис не
# поднимется. Строка нужна только чтобы выключить шаг при заданном адресе.
# SANDBOX_ENABLED=false
SANDBOX_URL=                        # https://sandbox.example.com — ЗАДАТЬ
SANDBOX_TOKEN=                      # он же SEC_TOKEN в CI
SANDBOX_PRIORITY=3                  # приоритет задачи в очереди песочницы
SANDBOX_SHORT_RESULT=true           # короткий ответ вместо полного
SANDBOX_TIMEOUT_SECONDS=900         # песочница запускает образец по-настоящему
# Эквивалент `curl -k` из CI-шаблона. Отдельной настройкой, а не молча:
# выключенная проверка сертификата обязана быть видимым решением.
SANDBOX_INSECURE_TLS=false

# --- снятые шаги: политические баннеры и SAST -------------------------------
# Оба шага СНЯТЫ с конвейера (решение пользователя, «на данном этапе пока
# убрать»). Настройки оставлены вместе с реализацией: вернуть шаг в строй —
# это строка в pipeline.Steps плюс миграция на CHECK-ограничение, а не
# написание сканера заново. Значения по умолчанию false: включённым должен
# оказаться только тот шаг, который вернули явно.
#
# Пока шаг снят, эти переменные ни на что не влияют.
BANNER_SCAN_ENABLED=false
BANNER_RULES_FILE=/config/rules.yar
BANNER_SCAN_TOTAL_TIMEOUT_SECONDS=120   # таймаут на весь прогон сканера
BANNER_SCAN_TOTAL_TIMEOUT_SECONDS=300

# --- реестры пакетных менеджеров --------------------------------------------
# Откуда сервис берёт метаданные и артефакты. В закрытом контуре подставьте
# внутренние зеркала — конвейер целиком перейдёт на них, кода это не касается.
REGISTRY_PYPI_URL=https://pypi.org
REGISTRY_NPM_URL=https://registry.npmjs.org
REGISTRY_GO_PROXY=https://proxy.golang.org
REGISTRY_GO_LICENSE_URL=https://pkg.go.dev
REGISTRY_NUGET_URL=https://api.nuget.org
REGISTRY_MAVEN_URL=https://repo.maven.apache.org/maven2,https://repo1.maven.org/maven2,https://dl.google.com/dl/android/maven2,https://repo.clojars.org,https://plugins.gradle.org/m2
REGISTRY_MAVEN_SEARCH_URL=https://search.maven.org   # только отсюда берётся дата публикации
REGISTRY_DOCKER_URL=https://registry-1.docker.io
REGISTRY_DOCKER_AUTH_URL=https://auth.docker.io/token
REGISTRY_DOCKER_SERVICE=registry.docker.io
REGISTRY_CONAN_URL=https://center2.conan.io
REGISTRY_LUAROCKS_URL=https://luarocks.org
REGISTRY_TERRAFORM_URL=https://registry.terraform.io
REGISTRY_PACKAGIST_URL=https://repo.packagist.org

# Менеджер git обращается к репозиториям внешним бинарём: реализовать протокол
# git внутри сервиса несопоставимо дороже, чем вызвать тот же клиент, которым
# пользуются все. Без него модерация репозиториев не работает — шаг скажет об
# этом прямо, а не пропустит пакет.
GIT_BINARY=git
GIT_CLONE_TIMEOUT_SECONDS=600

# Повторы и предохранитель на вызовах к реестрам.
#
# Повтор — реестр моргнул, пробуем ещё раз. Без него один 502 переигрывал бы
# весь прогон пакета целиком, со скачиванием артефакта и походом в песочницу.
#
# Предохранитель — реестр лежит, и долбиться в него бессмысленно: каждая
# попытка тратит таймаут, а пакетов в очереди сотня. После стольких неудач
# подряд обращения приостанавливаются, затем пускается ОДНА пробная попытка.
REGISTRY_RETRY_ATTEMPTS=3
REGISTRY_RETRY_BASE_DELAY_MS=300
REGISTRY_RETRY_MAX_DELAY_MS=3000
REGISTRY_BREAKER_THRESHOLD=5
REGISTRY_BREAKER_OPEN_SECONDS=30

# --- наблюдатель сканирования (Go-версия) -----------------------------------
# Сам находит пакеты заявок, по которым отчётов ещё нет, и прогоняет по ним
# сканеры. Нужен, пока заявки ведёт python-конвейер, а отчёты умеет делать
# только Go: без него отчёты появлялись бы только там, где не забыли запустить
# `moderation scan` вручную.
SCAN_WATCHER_ENABLED=true
SCAN_WATCHER_INTERVAL_SECONDS=60    # как часто смотреть, нет ли новых пакетов
SCAN_WATCHER_BATCH=10               # сколько пакетов разбирать за один проход
SCAN_WATCHER_ITEM_TIMEOUT_SECONDS=1200  # потолок на один пакет (качаем артефакт из внешнего реестра)

# --- очередь конвейера (go-воркер) -----------------------------------------
# Очередь — строки request_item в статусе `queued`; отдельного брокера нет.
# PIPELINE_STUCK_AFTER_SECONDS выше читает и go-воркер: прогон, не подававший
# признаков жизни втрое дольше этого срока, считается брошенным и подбирается
# заново.
#
# PIPELINE_WATCHDOG_* (см. «надёжность обработки очереди» выше) go-версия
# читает те же: у api-go свой сторож очереди с тем же смыслом. Он забирает
# пакеты, пролежавшие в очереди дольше PIPELINE_STUCK_AFTER_SECONDS, и гоняет
# конвейер в процессе API — страховка от «воркера нет, пакет ждёт вечно».
# Выделенный воркер забирает пакеты сразу, поэтому до сторожа доживает только
# то, что не взял никто, и настройка одна на обе версии не мешает.

# SAST по исходникам пакета — шаг тоже снят, см. раздел выше.
SAST_ENABLED=false
SAST_SCANNER_BIN=semgrep
# p/default semgrep скачивает из своего реестра — значит, нужен доступ в
# интернет (через HTTP_PROXY, если он у вас есть). В закрытой сети положите
# свой файл правил в config/ и укажите путь: SAST_RULES=/config/semgrep.yml —
# тогда сеть шагу не нужна вовсе.
SAST_RULES=p/default            # набор правил semgrep либо путь к своему файлу
SAST_TIMEOUT_SECONDS=300
SAST_MIN_SEVERITY=high          # info|low|medium|high|critical — ниже порога не блокирует

# Границы распаковки артефакта перед сканированием (защита от архивной бомбы).
SCAN_MAX_UNPACKED_BYTES=536870912   # 512 МБ
SCAN_MAX_FILES=20000

# --- база уязвимостей OSV ---------------------------------------------------
OSV_SNAPSHOT_PATH=osv/latest/osv-all.zip   # путь к снапшоту внутри ARTIFACT_REPO_OSV

# Откуда сервис берёт снапшот: artifactory (по умолчанию) | http | file.
# Разбор вариантов, с тем что чем платится, — docs/osv-snapshot.md.
#
#   artifactory — файл лежит в ARTIFACT_REPO_OSV. Доступ уже настроен, версия
#                 берётся из метаданных артефактори (настоящая sha256).
#   http        — файл отдаётся по адресу (внутреннее зеркало, nginx, объектное
#                 хранилище). Задайте OSV_DB_URL. Если сервер не отдаёт ETag и
#                 Last-Modified, снапшот будет качаться целиком на каждой
#                 проверке обновлений: версию иначе не узнать.
#   file        — файл уже на диске воркера, его кладёт туда чужой процесс.
#                 Задайте OSV_DB_FILE. Доступ наружу не нужен вовсе, но за
#                 доставку файла НА КАЖДЫЙ воркер отвечаете вы.
#
# Онлайновый запрос к osv.dev сознательно не поддержан — почему, см. документ.
OSV_DB_SOURCE=artifactory
OSV_DB_URL=                         # для OSV_DB_SOURCE=http
OSV_DB_TOKEN=                       # необязательно, уходит заголовком Authorization
OSV_DB_FILE=                        # для OSV_DB_SOURCE=file, путь к zip-файлу
OSV_LOCAL_DB_PATH=/var/lib/osv-db   # куда распаковывается снапшот
OSV_MAX_STALENESS_DAYS=3            # снапшот старше -> автоодобрение выключено, warn на шаге уязвимостей
# Расписание задаётся интервалом, а не cron-строкой (было OSV_SYNC_CRON):
# см. OSV_SYNC_INTERVAL_SECONDS в разделе регламентных задач.
# OSV_API_URL и OSV_SCANNER_BIN больше нет: онлайнового запроса к osv.dev и
# внешнего бинаря osv-scanner в go-версии нет — проверка идёт по снапшоту.

# --- доступ (OIDC / Keycloak) ----------------------------------------------
OIDC_ISSUER=http://keycloak:8080/realms/moderation
# Issuer, видимый из БРАУЗЕРА. Keycloak проксируется nginx'ом на том же origin
# (см. nginx/snippets/app.conf), поэтому здесь адрес самого сервиса без
# отдельного порта — не localhost:8081 и не :8443. Отдельный порт для Keycloak
# наружу больше не нужен.
OIDC_PUBLIC_ISSUER=http://localhost:8080/realms/moderation
OIDC_CLIENT_ID=moderation-web
# OIDC_CLIENT_SECRET и OIDC_AUDIENCE не читаются: клиент публичный
# (Authorization Code + PKCE), а aud сервис не проверяет намеренно — Keycloak
# кладёт идентификатор клиента в azp, а в aud "account" (см. internal/auth/jwt.go).
ROLE_MAPPING_ADMIN=moderation-admin
ROLE_MAPPING_DEVSECOPS=moderation-devsecops
ROLE_MAPPING_LEGAL=moderation-legal
ROLE_MAPPING_DEVELOPER=moderation-developer
LOCAL_AUTH_ENABLED=false            # fallback-вход логин/пароль (только сервисные учётки); в prod false
LOCAL_AUTH_SECRET=change-me-in-prod # ключ подписи локальных JWT
LOCAL_AUTH_TOKEN_TTL_MINUTES=480

# --- GitLab (только чтение) -------------------------------------------------
GITLAB_URL=
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/gitlab/callback
# Ключ Fernet для шифрования refresh-токенов GitLab (44 симв. base64).
# Сгенерировать: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- лимиты -----------------------------------------------------------------
MAX_UPLOAD_SIZE_BYTES=5242880       # размер файла зависимостей
MAX_PACKAGES_PER_REQUEST=200        # число пакетов в одной заявке

# --- Раскрытие транзитивных зависимостей -------------------------------------
# Работает по галочке в интерфейсе (include_transitive), а не всегда: раскрытие
# ходит в реестр по каждому узлу и заводит на модерацию всё найденное.
#
# Пределы подбираются под свою экосистему: глубина 3 по npm — это сотни пакетов,
# по nuget — единицы. MAX_PACKAGES_PER_REQUEST главнее: раскрытие не заведёт
# больше, чем разрешено завести руками, а об обрезке дерева заявка скажет явно.
RESOLVE_MAX_DEPTH=3                 # до какой глубины раскрывать (1 — только прямые)
RESOLVE_MAX_PACKAGES=200            # предел размера дерева
RESOLVE_INCLUDE_OPTIONAL=false      # extras у pypi, optionalDependencies у npm
RESOLVE_CONCURRENCY=8               # сколько узлов раскрывается одновременно
# Частота запросов — НА ПОЛЬЗОВАТЕЛЯ, а не на адрес: за одним адресом сидит
# весь офис через корпоративный прокси, и лимит на адрес означал бы, что
# активный разработчик перекрывает кислород остальным. Запросы без опознанного
# пользователя (health, метрики, /auth/config) не считаются вовсе.
# 0 и меньше — ограничение выключено.
RATE_LIMIT_REQUESTS_PER_MINUTE=30
MAX_ARTIFACT_SIZE_BYTES=524288000   # лимит размера скачиваемого артефакта (500 МБ)
MAX_DOCKER_ARTIFACT_SIZE_BYTES=2147483648 # весь multi-platform OCI index со слоями (2 ГиБ)
# HTTP_RETRIES и CIRCUIT_BREAKER_* переехали в REGISTRY_* (см. раздел реестров):
# повторяется отдельный запрос к реестру, а не весь прогон пакета целиком.
# HTTP_TIMEOUT_SECONDS больше нет: таймаут клиента общий и задан в коде.
COMMENT_EDIT_WINDOW_MINUTES=15      # N минут на правку комментария без пометки «изменено»

# --- внешние контейнеры (compose profiles) ---------------------------------
# Порты, публикуемые наружу в dev/override
NGINX_PORT=8080                     # HTTP; для боевого хоста 80
NGINX_TLS_PORT=8443                 # HTTPS; для боевого хоста 443
KEYCLOAK_PORT=8081
KEYCLOAK_TLS_PORT=9443              # HTTPS Keycloak
NEXUS_PORT=8082
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin       # СМЕНИТЬ в prod

# Пароль администратора Nexus переменной окружения не задаётся: образ
# sonatype/nexus3 такой возможности не даёт. При первом старте с
# NEXUS_SECURITY_RANDOMPASSWORD=false (см. docker-compose.yml) действует
# встроенный пароль `admin123`, и менять его нужно в самом Nexus — через UI
# или REST API. После смены пароля обновите ARTIFACT_TOKEN выше: именно по
# паре ARTIFACT_USER / ARTIFACT_TOKEN сервис публикует пакеты.

# ============================================================================
# Развёртывание на хосте, доступном по имени (не localhost)
# ============================================================================
# SPA использует window.crypto.subtle для PKCE, а он доступен только в secure
# context — то есть по HTTPS либо на localhost. По HTTP на внешнем имени вход
# через SSO падает с "Cannot read properties of undefined (reading 'digest')".
# Поэтому для внешнего хоста HTTPS обязателен, а не желателен.
#
# 1. Сертификат (самоподписанный; в бою — от внутреннего CA):
#      make certs DOMAIN=service.example.com
#    Если этого не сделать, nginx сгенерирует самоподписанный сам при старте.
#
# 2. Значения в .env:
#      PUBLIC_BASE_URL=https://service.example.com
#      NGINX_PORT=80
#      NGINX_TLS_PORT=443
#      NGINX_FORCE_HTTPS=true
#      OIDC_PUBLIC_ISSUER=https://service.example.com/realms/moderation
#      GITLAB_OAUTH_REDIRECT_URI=https://service.example.com/api/v1/gitlab/callback
#
#    БЕЗ порта у OIDC_PUBLIC_ISSUER: Keycloak проксируется nginx'ом на 443
#    вместе с приложением. Раньше здесь стоял :8443, и это не работало —
#    Keycloak без сертификата HTTPS не поднимает (порт опубликован, а внутри
#    контейнера на нём никто не слушает: ERR_CONNECTION_REFUSED), плюс 8443
#    обычно закрыт фаерволом, плюс самоподписанный сертификат ронял бы fetch
#    к .well-known молча. KEYCLOAK_TLS_PORT наружу больше не нужен.
#
#    OIDC_ISSUER не трогать: он внутренний (http://keycloak:8080/realms/moderation),
#    api ходит по нему внутри сети compose. Сервис принимает оба issuer'а —
#    браузерный и внутренний.
#
# 3. Поднять:
#      docker compose --profile sso --profile nexus up -d --build
#
#    Оверлей docker-compose.tls.yml (общий сертификат для nginx и Keycloak)
#    теперь нужен ТОЛЬКО если вы сознательно выставляете Keycloak наружу
#    отдельным портом в обход nginx. Для обычного развёртывания он не нужен:
#    браузер ходит к Keycloak через nginx, сертификат один.
